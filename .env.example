# Kirari Core 配置示例
#
# 复制为 .env 后按需修改：cp .env.example .env
# .env 不要提交到 Git（已在 .gitignore 中）。
#
# 📐 命名约定（与桌面端统一）：环境变量文件一律叫 `.env`。
#    两端**没有任何共通变量** —— 包括组网密钥（见下方「组网」一节，不需要配）。

# ── 监听 ─────────────────────────────────────────────────────────────
# 服务端口。不设时默认 9089；被占用时会在候选端口里找一个。
PORT=9089
# 绑定网卡。服务器部署保持 0.0.0.0（对外可访问）；
# 只允许本机访问则改成 127.0.0.1。
HOST=0.0.0.0

# 会话存储：db = 落 SQLite（重启不丢记忆）；memory = 只存内存
STORAGE_TYPE=db

# ── 模型（这里不配！）────────────────────────────────────────────────
# ⚠️ 模型配置的唯一入口是控制台「大脑」（/console → 大脑）：
#    可加多套「服务地址 + 型号 + 钥匙」并选当前使用，改完即生效。
#    控制台账号（BOT_MODEL_UID，默认 1）的配置存 data/config.json（与桌面端同构）；
#    其他老账号仍走 SQLite 旧路径（保留、不发展）。
#    .env 里配模型的老写法（MODEL_ENDPOINT / MODEL_API_ENDPOINT）已删除，写了也没用。

# ── 机器人接入（用 POST /v1/chat 时必填）─────────────────────────────
# 接入口令。机器人侧请求头带 Authorization: Bearer <这个值>。
# 生成方式：openssl rand -hex 32
# 不设置则 /v1/chat 直接拒绝（不会默认放行）。
BOT_TOKEN=

# 机器人用哪个账号的模型配置。默认 1（控制台账号，读 data/config.json）。
# 多账号部署时可指向具体 uid（非控制台账号仍读 SQLite 旧路径）。
BOT_MODEL_UID=1

# 群聊是否按发言人隔离上下文：
#   false（默认）→ 整群共享一份上下文，符合群聊直觉
#   true          → 群内每人一份上下文
# 注意：位置记忆始终按群共享，不受此影响。
BOT_GROUP_ISOLATE_PER_USER=false

# ── Web 控制台（可选）───────────────────────────────────────────────
# 管理口令。浏览器控制台（/console）的所有接口都要求请求头 X-Admin-Token: <这个值>。
# 生成方式：openssl rand -hex 32
# ⚠️ 不设置 = 控制台整体禁用（接口返回 503 并说明），**不会**默认放行。
# 注册登录已下线：管理面只有这一个口令。
ADMIN_PASSWORD=

# ── 内置账户（本地/单人部署用；服务器部署可忽略）────────────────────
BUILTIN_ACCOUNT_TOKEN=kirari-local-builtin
SESSION_SECRET=change-me-to-a-long-random-string

# ── 组网（活锁模型，可选）────────────────────────────────────────────
# 核心版也能当主机、也能当叶子（ARCHITECTURE-PLAN §1.2 的能力对等硬约束）。
# 不配这一段 = 不参与组网，机器人本体照常工作。

# ⚠️ 组网**没有需要配置的密钥**。两端地位完全一样，谁也不带密钥出厂：
#      · 当主机（NET_ROLE=host）→ 第一次启动时自己签一把，只存在本机
#        （落在 NET_STATE_DIR 的 net-state.json 里，权限 600）
#      · 当叶子（NET_ROLE=leaf）→ 贴一张主机给的连接码，密钥在配对那一刻领到
#    所以同一个镜像发给不同的人，是互不相通、也互不可见的若干张网。
#    （历史变量 KIRARI_NET_SECRET 已删除，写了也没用。）

# 本机在组网里的角色：
#   off  （默认）不参与组网
#   host   当主机：为其他设备提供模型出口（7×24 常开机器推荐这个）
#   leaf   当叶子：把请求上行给主机，本机不需要配模型 Key
NET_ROLE=off

# 组网状态目录（凭据、配对码列表、本机密钥都存这儿）。默认 <仓库>/data/net。
# 容器部署时挂个卷更稳妥 —— 丢了它就得重新配对。
# NET_STATE_DIR=/opt/kirari-core/data/net

# 仅当 NET_ROLE=leaf 且**首次**接入时填：主机那边生成的连接码（整串复制）。
# 本机手上没有密钥也没关系，密钥会在配对那一刻由主机发过来。
# 接入成功后凭据会存进状态目录，这行就可以删掉了（下次开机自动重连）。
# NET_PAIRING_CODE=kirari://join?d=xxxxx

# 仅当 NET_ROLE=host 时需要，两种情况必填：
#   1) 跑在容器里（桥接网络）—— 不指定的话连接码里会写容器内网地址，对方连不上
#   2) 机器有多张网卡，自动猜的那张不是局域网里能互相访问的那张
# 值填「对方能访问到你的那个地址」，例如 192.168.57.169。
# 不填则自动猜（取第一个 192.168/10/172.16-31 网段的地址）。
# NET_ADVERTISE_HOST=192.168.57.169

# 仅当 NET_ROLE=host 且需要连接码时才设：启动时签发一个并打进日志。
# 默认不打印 —— 连接码等同于密码，不该默认往日志里写。
# 更正规的做法是在 Web 控制台里点一下签发。
# NET_PRINT_PAIRING=1


# ── 调优（可选）──────────────────────────────────────────────────────
# AI 上下文空闲多久后释放（毫秒），默认 30 分钟。HTTP 接入每条消息都会用，
# 复用上下文避免反复新建；这个值决定闲置多久才真正释放。
AI_CONTEXT_IDLE_TTL_MS=1800000
