# Kirari Core 配置示例
#
# 复制为 .env 后按需修改：cp .env.example .env
# .env 不要提交到 Git（已在 .gitignore 中）。

# ── 监听 ─────────────────────────────────────────────────────────────
# 服务端口。不设时默认 9089；被占用时会在候选端口里找一个。
PORT=9089
# 绑定网卡。服务器部署保持 0.0.0.0（对外可访问）；
# 只允许本机访问则改成 127.0.0.1。
HOST=0.0.0.0

# 会话存储：db = 落 SQLite（重启不丢记忆）；memory = 只存内存
STORAGE_TYPE=db

# ── 模型（必填）──────────────────────────────────────────────────────
# 模型服务地址，需兼容 OpenAI API 格式
MODEL_API_ENDPOINT=https://api.chatanywhere.tech/v1
# 该账号的模型地址/型号/密钥通过 POST /api-token 或桌面端设置页写入 SQLite，
# 不在这里配（一个部署可能有多账号）。

# ── 机器人接入（用 POST /v1/chat 时必填）─────────────────────────────
# 接入口令。机器人侧请求头带 Authorization: Bearer <这个值>。
# 生成方式：openssl rand -hex 32
# 不设置则 /v1/chat 直接拒绝（不会默认放行）。
BOT_TOKEN=

# 机器人用哪个账号的模型配置（对应 SQLite 里 api_tokens 的 userid）。
# 默认 1（内置账号）。多账号部署时可指向具体 uid。
BOT_MODEL_UID=1

# 群聊是否按发言人隔离上下文：
#   false（默认）→ 整群共享一份上下文，符合群聊直觉
#   true          → 群内每人一份上下文
# 注意：位置记忆始终按群共享，不受此影响。
BOT_GROUP_ISOLATE_PER_USER=false

# ── 内置账户（本地/单人部署用；服务器部署可忽略）────────────────────
BUILTIN_ACCOUNT_TOKEN=kirari-local-builtin
SESSION_SECRET=change-me-to-a-long-random-string

# ── 调优（可选）──────────────────────────────────────────────────────
# AI 上下文空闲多久后释放（毫秒），默认 30 分钟。HTTP 接入每条消息都会用，
# 复用上下文避免反复新建；这个值决定闲置多久才真正释放。
AI_CONTEXT_IDLE_TTL_MS=1800000
